@* @using System.Globalization *@
<div class="mt-5 border border-1 p-4">
    @if (Payments.Count > 0)
    {
        <h2 class="mb-4 text-center">Payment Schedule</h2>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Month</th>
                        <th>Payment</th>
                        <th>Principal</th>
                        <th>Interest</th>
                        <th>Total Interest</th>
                        <th>Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Payments)
                    {
                        <tr class="text-end">
                            <td>@item.Month</td>
                            <td>@item.Payment.ToString("C", CultureInfo.CurrentCulture)</td>
                            <td>@item.MonthlyPrincipal.ToString("C", CultureInfo.CurrentCulture)</td>
                            <td>@item.MonthlyInterest.ToString("C", CultureInfo.CurrentCulture)</td>
                            <td>@item.TotalInterest.ToString("C", CultureInfo.CurrentCulture)</td>
                            <td>@item.Balance.ToString("C", CultureInfo.CurrentCulture)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p>No payments to dislay. Enter some values and press calculate to see loan payments.</p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public List<LoanPayment> Payments { get; set; } = new();
}